---
# Managed by Ansible (roles/monitoring). Do not edit on the host.
#
# Node-exporter and cAdvisor run as global services, so there is one task per
# node. Instead of hard-coding node IPs, Prometheus uses Docker Swarm service
# discovery against the local manager socket and keeps only the tasks it wants.

global:
  scrape_interval: 15s
  evaluation_interval: 15s
  external_labels:
    cluster: swarm

scrape_configs:
  # Prometheus scraping itself.
  - job_name: prometheus
    static_configs:
      - targets: ['localhost:9090']

  # Host metrics from node-exporter (one task per node, port 9100).
  - job_name: node-exporter
    dockerswarm_sd_configs:
      - host: unix:///var/run/docker.sock
        role: tasks
    relabel_configs:
      - source_labels: [__meta_dockerswarm_service_name]
        regex: monitoring_node-exporter
        action: keep
      - source_labels: [__meta_dockerswarm_task_desired_state]
        regex: running
        action: keep
      # In a stack the overlay network is named <stack>_monitoring.
      - source_labels: [__meta_dockerswarm_network_name]
        regex: .*_monitoring
        action: keep
      # Force the exporter port (don't rely on exposed-port detection).
      - source_labels: [__address__]
        regex: '([^:]+)(?::\d+)?'
        replacement: '${1}:9100'
        target_label: __address__
      # Label each series with the node hostname rather than a container IP.
      - source_labels: [__meta_dockerswarm_node_hostname]
        target_label: instance

  # Container metrics from cAdvisor (one task per node, port 8080).
  - job_name: cadvisor
    dockerswarm_sd_configs:
      - host: unix:///var/run/docker.sock
        role: tasks
    relabel_configs:
      - source_labels: [__meta_dockerswarm_service_name]
        regex: monitoring_cadvisor
        action: keep
      - source_labels: [__meta_dockerswarm_task_desired_state]
        regex: running
        action: keep
      # In a stack the overlay network is named <stack>_monitoring.
      - source_labels: [__meta_dockerswarm_network_name]
        regex: .*_monitoring
        action: keep
      # Force the cAdvisor port (don't rely on exposed-port detection).
      - source_labels: [__address__]
        regex: '([^:]+)(?::\d+)?'
        replacement: '${1}:8080'
        target_label: __address__
      - source_labels: [__meta_dockerswarm_node_hostname]
        target_label: instance
{% if traefik_enabled | bool %}

  # Traefik's own metrics: per-router/service request counts, status codes and
  # latency histograms. This is what makes the canary split measurable — with
  # addServicesLabels on, stable and canary appear as two 'service' series.
  # Single manager-pinned task; it joins the monitoring overlay so the metrics
  # entrypoint never has to be published on the host.
  - job_name: traefik
    dockerswarm_sd_configs:
      - host: unix:///var/run/docker.sock
        role: tasks
    relabel_configs:
      - source_labels: [__meta_dockerswarm_service_name]
        regex: traefik_traefik
        action: keep
      - source_labels: [__meta_dockerswarm_task_desired_state]
        regex: running
        action: keep
      # Keep the task's address on the monitoring overlay, not on traefik-public.
      - source_labels: [__meta_dockerswarm_network_name]
        regex: .*_monitoring
        action: keep
      # Force the metrics entrypoint port.
      - source_labels: [__address__]
        regex: '([^:]+)(?::\d+)?'
        replacement: '${1}:{{ traefik_metrics_port }}'
        target_label: __address__
      - source_labels: [__meta_dockerswarm_node_hostname]
        target_label: instance
{% endif %}
