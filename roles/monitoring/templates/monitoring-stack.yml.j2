# Managed by Ansible (roles/monitoring). Deployed with:
#   docker stack deploy -c monitoring-stack.yml monitoring
#
# Service names become monitoring_<name> in the swarm; the Prometheus scrape
# config relabels on those names. Prometheus/Grafana/Portainer are pinned to
# the manager so their named volumes and bind mounts always resolve there.
version: "3.8"

networks:
  monitoring:
    driver: overlay
    attachable: true

volumes:
  prometheus_data:
  grafana_data:
{% if portainer_enabled | bool %}
  portainer_data:
{% endif %}

services:

  # ---- Host metrics: one task per node -----------------------------------
  node-exporter:
    image: {{ node_exporter_image }}
    command:
      - '--path.rootfs=/host'
      - '--collector.filesystem.mount-points-exclude=^/(sys|proc|dev|host|etc)($$|/)'
    volumes:
      - /:/host:ro,rslave
    networks:
      - monitoring
    deploy:
      mode: global
      resources:
        limits:
          memory: 128M

  # ---- Container metrics: one task per node ------------------------------
  cadvisor:
    image: {{ cadvisor_image }}
    command:
      - '--docker_only=true'
      - '--housekeeping_interval=15s'
    volumes:
      - /:/rootfs:ro
      - /var/run:/var/run:ro
      - /sys:/sys:ro
      - /var/lib/docker/:/var/lib/docker:ro
      - /dev/disk/:/dev/disk:ro
    networks:
      - monitoring
    deploy:
      mode: global
      resources:
        limits:
          memory: 256M

  # ---- Prometheus: scrape + TSDB (manager-pinned) ------------------------
  prometheus:
    image: {{ prometheus_image }}
    # Run as root so the process can read the bind-mounted Docker socket
    # (root:docker 660). Without this, Swarm service discovery gets EACCES
    # and finds no node-exporter/cAdvisor tasks.
    user: root
    command:
      - '--config.file=/etc/prometheus/prometheus.yml'
      - '--storage.tsdb.path=/prometheus'
      - '--storage.tsdb.retention.time={{ prometheus_retention }}'
      - '--web.enable-lifecycle'
    volumes:
      - {{ monitoring_dir }}/prometheus/prometheus.yml:/etc/prometheus/prometheus.yml:ro
      - prometheus_data:/prometheus
      # Needed for Docker Swarm service discovery (manager API).
      - /var/run/docker.sock:/var/run/docker.sock:ro
    networks:
      - monitoring
    ports:
      - "{{ prometheus_port }}:9090"
    deploy:
      mode: replicated
      replicas: 1
      placement:
        constraints:
          - node.role == manager

  # ---- Grafana: dashboards (manager-pinned) ------------------------------
  grafana:
    image: {{ grafana_image }}
    environment:
      GF_SECURITY_ADMIN_PASSWORD: "{{ grafana_admin_password }}"
      GF_USERS_ALLOW_SIGN_UP: "false"
    volumes:
      - grafana_data:/var/lib/grafana
      - {{ monitoring_dir }}/grafana/provisioning:/etc/grafana/provisioning:ro
      - {{ monitoring_dir }}/grafana/dashboards:/var/lib/grafana/dashboards:ro
    networks:
      - monitoring
    ports:
      - "{{ grafana_port }}:3000"
    deploy:
      mode: replicated
      replicas: 1
      placement:
        constraints:
          - node.role == manager
{% if portainer_enabled | bool %}

  # ---- Portainer agent: one task per node --------------------------------
  agent:
    image: {{ portainer_agent_image }}
    environment:
      AGENT_CLUSTER_ADDR: tasks.agent
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      - /var/lib/docker/volumes:/var/lib/docker/volumes
    networks:
      - monitoring
    deploy:
      mode: global
      placement:
        constraints:
          - node.platform.os == linux

  # ---- Portainer server: cluster UI (manager-pinned) ---------------------
  portainer:
    image: {{ portainer_image }}
    command: -H tcp://tasks.agent:9001 --tlsskipverify
    volumes:
      - portainer_data:/data
    networks:
      - monitoring
    ports:
      - "{{ portainer_port }}:9443"
    deploy:
      mode: replicated
      replicas: 1
      placement:
        constraints:
          - node.role == manager
{% endif %}
