{
  "uid": "canary-rollout",
  "title": "Canary Rollout (Traefik)",
  "tags": ["swarm", "traefik", "canary"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Canary share of requests",
      "description": "Observed, not configured. Compare against the weight canary-weight.sh wrote; they converge within a few points once traffic is steady.",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "decimals": 1, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 25 }, { "color": "orange", "value": 50 } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "100 * sum(rate(traefik_service_requests_total{service=\"todo-canary@swarm\"}[1m])) / clamp_min(sum(rate(traefik_service_requests_total{service=~\"todo-(stable|canary)@swarm\"}[1m])), 0.0001)" }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Canary 5xx rate",
      "description": "The main abort signal. Anything sustained above a couple of percent means roll back: canary-weight.sh 100 0",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "decimals": 2, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 1 }, { "color": "red", "value": 2 } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "100 * sum(rate(traefik_service_requests_total{service=\"todo-canary@swarm\",code=~\"5..\"}[1m])) / clamp_min(sum(rate(traefik_service_requests_total{service=\"todo-canary@swarm\"}[1m])), 0.0001)" }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Canary p99 latency",
      "description": "The second abort signal: a canary that answers but answers slowly.",
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s", "min": 0, "decimals": 3, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 1 }, { "color": "red", "value": 2 } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "histogram_quantile(0.99, sum by (le) (rate(traefik_service_request_duration_seconds_bucket{service=\"todo-canary@swarm\"}[5m])))" }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Requests/s through the edge",
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0, "decimals": 1, "color": { "mode": "fixed", "fixedColor": "blue" } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(rate(traefik_entrypoint_requests_total{entrypoint=\"web\"}[1m]))" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Traffic split (stable vs canary)",
      "description": "Stacked to 100%, so each step of the rollout shows up as a step in this chart.",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0, "custom": { "fillOpacity": 45, "lineWidth": 1, "stacking": { "mode": "percent", "group": "A" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "mean"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "legendFormat": "{{service}}", "expr": "sum by (service) (rate(traefik_service_requests_total{service=~\"todo-(stable|canary)@swarm\"}[1m]))" }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Request rate by version and status code",
      "description": "A canary going bad shows here first: a 5xx series that only exists for todo-canary.",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0, "custom": { "fillOpacity": 10, "lineWidth": 2 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "legendFormat": "{{service}} {{code}}", "expr": "sum by (service, code) (rate(traefik_service_requests_total{service=~\"todo-(stable|canary)@swarm\"}[1m]))" }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Error ratio by version",
      "description": "5xx as a share of each version's own requests, so a 10% canary is compared fairly against a 90% stable.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "custom": { "fillOpacity": 10, "lineWidth": 2 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "legendFormat": "{{service}}", "expr": "100 * sum by (service) (rate(traefik_service_requests_total{service=~\"todo-(stable|canary)@swarm\",code=~\"5..\"}[1m])) / clamp_min(sum by (service) (rate(traefik_service_requests_total{service=~\"todo-(stable|canary)@swarm\"}[1m])), 0.0001)" }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Latency by version (p50 / p99)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s", "min": 0, "custom": { "fillOpacity": 0, "lineWidth": 2 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "legendFormat": "p50 {{service}}", "expr": "histogram_quantile(0.50, sum by (le, service) (rate(traefik_service_request_duration_seconds_bucket{service=~\"todo-(stable|canary)@swarm\"}[5m])))" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "prometheus" }, "legendFormat": "p99 {{service}}", "expr": "histogram_quantile(0.99, sum by (le, service) (rate(traefik_service_request_duration_seconds_bucket{service=~\"todo-(stable|canary)@swarm\"}[5m])))" }
      ]
    }
  ]
}
